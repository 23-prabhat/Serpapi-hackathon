!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# testing
coverage/
.coverage.*
coverage.xml
playwright-report/
test-results/
blob-report/

# next.js
.next/
out/

# production
build/
dist/
*.egg-info/

# misc
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.pem
*.key
*.p12
*.pfx

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
