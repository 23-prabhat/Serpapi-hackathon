# Kabtak shared local environment
# Copy this file to `kabtak/.env`. Never commit the resulting `.env` file.

# -----------------------------------------------------------------------------
# SHARED — read by both the FastAPI backend and the Next.js server
# -----------------------------------------------------------------------------

# Browser origin accepted by both same-origin proxy checks.
APP_ORIGIN=http://127.0.0.1:3000

# Generate with `openssl rand -hex 32`. This never reaches browser JavaScript.
INTERNAL_API_TOKEN=replace-with-a-long-random-token

# -----------------------------------------------------------------------------
# FRONTEND SERVER ONLY — used by Next.js route handlers, never NEXT_PUBLIC
# -----------------------------------------------------------------------------

BACKEND_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# BACKEND AND WORKER ONLY — application, storage, and safety budgets
# -----------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///../data/kabtak.db
DATA_DIR=../data

ACTIVE_RUN_TIMEOUT_SECONDS=180
SOURCE_REQUEST_TIMEOUT_SECONDS=15
SOURCE_PARSE_TIMEOUT_SECONDS=10
MAX_PDF_PAGES=20
OCR_ENABLED=true
OCR_TIMEOUT_SECONDS=25
MAX_OCR_PAGES=10
MAX_WAITING_RUNS=3
MAX_SEARCH_ATTEMPTS=4
MAX_SOURCE_DOCUMENTS=6
MAX_SOURCE_REQUESTS=12
MAX_LLM_ATTEMPTS=6

# -----------------------------------------------------------------------------
# BACKEND AND WORKER ONLY — live providers
# Offline historical examples work when these keys are blank.
# -----------------------------------------------------------------------------

SERPAPI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
