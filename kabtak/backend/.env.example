# Runtime
APP_ENV=development
LOG_LEVEL=INFO
APP_ORIGIN=http://127.0.0.1:3000
INTERNAL_API_TOKEN=replace-with-a-long-random-token

# Shared API/worker storage
DATABASE_URL=sqlite:///../data/kabtak.db
DATA_DIR=../data

# Live integrations (offline examples work without these)
SERPAPI_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Initial design budgets
ACTIVE_RUN_TIMEOUT_SECONDS=180
SOURCE_REQUEST_TIMEOUT_SECONDS=15
MAX_WAITING_RUNS=3
MAX_SEARCH_ATTEMPTS=4
MAX_SOURCE_DOCUMENTS=6
MAX_SOURCE_REQUESTS=12
MAX_LLM_ATTEMPTS=6
