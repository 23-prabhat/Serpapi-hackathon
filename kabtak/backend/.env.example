# Legacy service-local template.
# Prefer the single commented template at `kabtak/.env.example`; this file stays
# available for backwards compatibility and is overridden by `kabtak/.env`.

# Backend and worker runtime
APP_ENV=development
LOG_LEVEL=INFO
APP_ORIGIN=http://127.0.0.1:3000
INTERNAL_API_TOKEN=replace-with-a-long-random-token

# Backend and worker storage
DATABASE_URL=sqlite:///../data/kabtak.db
DATA_DIR=../data

# Live integrations (offline examples work without these)
SERPAPI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Initial design budgets
ACTIVE_RUN_TIMEOUT_SECONDS=180
SOURCE_REQUEST_TIMEOUT_SECONDS=15
SOURCE_PARSE_TIMEOUT_SECONDS=10
MAX_PDF_PAGES=20
MAX_WAITING_RUNS=3
MAX_SEARCH_ATTEMPTS=4
MAX_SOURCE_DOCUMENTS=6
MAX_SOURCE_REQUESTS=12
MAX_LLM_ATTEMPTS=6
