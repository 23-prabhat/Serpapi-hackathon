# Server-only URL for the local FastAPI process.
BACKEND_URL=http://127.0.0.1:8000

# Generate a unique value; it must match backend/.env.
INTERNAL_API_TOKEN=replace-with-a-long-random-token

# Used to reject cross-origin state-changing requests at the Next.js proxy.
APP_ORIGIN=http://127.0.0.1:3000
