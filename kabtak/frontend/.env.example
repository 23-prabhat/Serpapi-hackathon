# Legacy service-local template.
# Prefer the single commented template at `kabtak/.env.example`. Values in a
# local `.env.local` are still supported as explicit frontend overrides.

# Frontend server only: URL for the local FastAPI process.
BACKEND_URL=http://127.0.0.1:8000

# Shared with backend: generate a unique value.
INTERNAL_API_TOKEN=replace-with-a-long-random-token

# Shared with backend: used to reject cross-origin state-changing requests.
APP_ORIGIN=http://127.0.0.1:3000
